<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- Pull in Spring Boot defaults (colours, common patterns, etc.) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Service name — auto-detected from Spring Boot -->
    <springProperty scope="context" name="APP_NAME"
                    source="spring.application.name"
                    defaultValue="unknown-service"/>

    <!-- ============================================================ -->
    <!--  DEV / DEFAULT PROFILE — human-readable console               -->
    <!-- ============================================================ -->
    <springProfile name="dev,default">

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Quieter third-party noise during dev -->
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
    </springProfile>

    <!-- ============================================================ -->
    <!--  K8S / PROD PROFILE — JSON to stdout for Loki/ELK            -->
    <!-- ============================================================ -->
    <springProfile name="k8s,prod">

        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Core fields -->
                <customFields>{"service":"${APP_NAME}"}</customFields>
                <timeZone>UTC</timeZone>

                <!-- Include MDC values (requestId, traceId, spanId, userId) -->
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>

                <!-- Stack traces as single-line JSON strings -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>2048</maxLength>
                    <shortenedClassNameLength>40</shortenedClassNameLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>

                <!-- ISO-8601 timestamps -->
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>

        <!-- Reduce noise in production -->
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
        <logger name="org.springframework.cloud" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.example.apigateway" level="DEBUG"/>
    </springProfile>

</configuration>